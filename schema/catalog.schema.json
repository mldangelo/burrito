{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mldangelo/burrito/main/schema/catalog.schema.json",
  "title": "San Francisco burrito catalog",
  "description": "Sourced places, branch-specific recommendations and local weekly hours. Cross-reference and hours semantics are also validated by scripts/validate.mjs.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "title",
    "updated_on",
    "scope",
    "methodology",
    "sources",
    "places",
    "exclusions"
  ],
  "properties": {
    "$schema": {
      "const": "../schema/catalog.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "scope": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "city",
        "region",
        "country",
        "description"
      ],
      "properties": {
        "city": {
          "const": "San Francisco"
        },
        "region": {
          "const": "CA"
        },
        "country": {
          "const": "US"
        },
        "description": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "methodology": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "sources": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/source"
      },
      "minItems": 1
    },
    "places": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/place"
      },
      "minItems": 1
    },
    "exclusions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/exclusion"
      },
      "minItems": 0
    }
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "url",
        "title",
        "kind",
        "published_on",
        "checked_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "title": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "official",
            "ordering_menu",
            "editorial",
            "archive",
            "directory"
          ]
        },
        "published_on": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "interval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "opens",
        "closes",
        "closes_next_day"
      ],
      "properties": {
        "opens": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "closes": {
          "type": "string",
          "pattern": "^(?:[01][0-9]|2[0-3]):[0-5][0-9]$"
        },
        "closes_next_day": {
          "type": "boolean"
        }
      }
    },
    "hours": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "scope",
        "timezone",
        "weekly",
        "notes",
        "source_ids",
        "checked_on"
      ],
      "properties": {
        "status": {
          "enum": [
            "published",
            "partial",
            "conflicting",
            "unknown"
          ]
        },
        "scope": {
          "enum": [
            "restaurant",
            "kitchen",
            "online_ordering",
            "truck_schedule"
          ]
        },
        "timezone": {
          "const": "America/Los_Angeles"
        },
        "weekly": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "monday",
            "tuesday",
            "wednesday",
            "thursday",
            "friday",
            "saturday",
            "sunday"
          ],
          "properties": {
            "monday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            },
            "tuesday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            },
            "wednesday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            },
            "thursday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            },
            "friday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            },
            "saturday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            },
            "sunday": {
              "anyOf": [
                {
                  "type": "null"
                },
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/$defs/interval"
                  },
                  "minItems": 0
                }
              ]
            }
          }
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "address": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "street_address",
        "locality",
        "region",
        "postal_code",
        "country"
      ],
      "properties": {
        "street_address": {
          "type": "string",
          "minLength": 1
        },
        "locality": {
          "const": "San Francisco"
        },
        "region": {
          "const": "CA"
        },
        "postal_code": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^941[0-9]{2}$"
        },
        "country": {
          "const": "US"
        }
      }
    },
    "location": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "address",
        "neighborhood",
        "area",
        "operating_status",
        "maps_url",
        "hours",
        "notes",
        "source_ids",
        "checked_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "address": {
          "$ref": "#/$defs/address"
        },
        "neighborhood": {
          "type": "string",
          "minLength": 1
        },
        "area": {
          "enum": [
            "mission",
            "outside_mission"
          ]
        },
        "operating_status": {
          "enum": [
            "listed",
            "announced",
            "unconfirmed",
            "closed"
          ]
        },
        "maps_url": {
          "type": "string",
          "format": "uri",
          "pattern": "^https?://"
        },
        "hours": {
          "$ref": "#/$defs/hours"
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "item": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "basis",
        "notes",
        "location_ids",
        "source_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "basis": {
          "enum": [
            "editorial",
            "historical_review",
            "menu_candidate"
          ]
        },
        "notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "vibe": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "basis",
        "location_ids",
        "source_ids"
      ],
      "properties": {
        "summary": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "basis": {
          "enum": [
            "source_summary",
            "format_inference",
            "unknown"
          ]
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 0,
          "uniqueItems": true
        }
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "evidence",
        "summary",
        "location_ids",
        "source_ids"
      ],
      "properties": {
        "evidence": {
          "enum": [
            "burrito_specific_editorial",
            "restaurant_or_taco_editorial",
            "historical_burrito_review",
            "menu_or_local_candidate",
            "historical_significance",
            "unconfirmed"
          ]
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "location_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    },
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "status",
        "shortlist",
        "styles",
        "summary",
        "primary_location_id",
        "locations",
        "standout_items",
        "vibe",
        "reviews",
        "visit_notes",
        "research_gaps",
        "source_ids",
        "added_on",
        "checked_on"
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "catalog",
            "history",
            "watchlist"
          ]
        },
        "shortlist": {
          "type": "boolean"
        },
        "styles": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "primary_location_id": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "locations": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/location"
          },
          "minItems": 1
        },
        "standout_items": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/item"
          },
          "minItems": 1
        },
        "vibe": {
          "$ref": "#/$defs/vibe"
        },
        "reviews": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/review"
          },
          "minItems": 1
        },
        "visit_notes": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "research_gaps": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 0
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "added_on": {
          "type": "string",
          "format": "date"
        },
        "checked_on": {
          "type": "string",
          "format": "date"
        }
      }
    },
    "exclusion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "reason",
        "source_ids"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "source_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "minItems": 1,
          "uniqueItems": true
        }
      }
    }
  }
}
