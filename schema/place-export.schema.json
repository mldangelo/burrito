{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/mldangelo/burrito/main/schema/place-export.schema.json",
  "title": "Burrito place export",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "$schema",
    "schema_version",
    "canonical_url",
    "updated_on",
    "methodology",
    "place",
    "sources"
  ],
  "properties": {
    "$schema": {
      "const": "../../schema/place-export.schema.json"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "canonical_url": {
      "type": "string",
      "format": "uri"
    },
    "updated_on": {
      "type": "string",
      "format": "date"
    },
    "methodology": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      },
      "minItems": 1
    },
    "place": {
      "$ref": "catalog.schema.json#/$defs/place"
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "catalog.schema.json#/$defs/source"
      }
    }
  }
}
