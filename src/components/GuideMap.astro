---
import { mapGroups, project } from '../lib/map.mjs';
import rawGeography from '../../data/map/neighborhoods.geojson?raw';
const { locations, reviewedIds = [], href, title, label } = Astro.props;
const geography = JSON.parse(rawGeography);
const minX = Math.min(...locations.map((stop) => stop.x)) - 35;
const minY = Math.min(...locations.map((stop) => stop.y)) - 35;
const width = Math.max(...locations.map((stop) => stop.x)) - minX + 35;
const height = Math.max(...locations.map((stop) => stop.y)) - minY + 35;
const scale = Math.max(width, height) / 200;
const groups = mapGroups(locations, { single: 3.4 * scale, group: 5 * scale, gap: 1.5 * scale });
const polygons = (geometry) =>
  geometry.type === 'MultiPolygon' ? geometry.coordinates : [geometry.coordinates];
const visibleFeatures = geography.features.filter((feature) => {
  const positions = polygons(feature.geometry).flat(2).map(project);
  return (
    Math.max(...positions.map(([x]) => x)) >= minX &&
    Math.min(...positions.map(([x]) => x)) <= minX + width &&
    Math.max(...positions.map(([, y]) => y)) >= minY &&
    Math.min(...positions.map(([, y]) => y)) <= minY + height
  );
});
const shape = (geometry) =>
  polygons(geometry)
    .flat()
    .map(
      (ring) =>
        ring
          .map(
            (position, i) =>
              `${i ? 'L' : 'M'}${project(position)
                .map((n) => n.toFixed(2))
                .join(',')}`,
          )
          .join('') + 'Z',
    )
    .join('');
---

<a class="mission-map-card california-map-card" href={href} aria-label={label}>
  <div class="mission-map-heading">
    <span>{title}</span>
    <span aria-hidden="true">N ↑</span>
  </div>
  <svg viewBox={`${minX} ${minY} ${width} ${height}`} role="img" aria-label={label}>
    {visibleFeatures.map((feature) => (
      <path
        d={shape(feature.geometry)}
        class:list={[
          'mission-map-land',
          { 'mission-map-area': feature.properties.name === 'Golden Gate Park' },
        ]}
      />
    ))}
    {groups.map((group) => {
      const reviewed = group.locations.some((stop) => reviewedIds.includes(stop.id));
      const radius = (group.locations.length > 1 ? 5 : 3.4) * scale;
      return (
        <g class:list={{ 'guide-map-reviewed': reviewed }}>
          <title>{group.locations.map((stop) => stop.name).join(', ')}{reviewed ? ' · Includes critical coverage' : ''}</title>
          <circle cx={group.x} cy={group.y} r={radius} style={`stroke-width: ${0.8 * scale}`} />
          {(group.locations.length > 1 || reviewed) && (
            <text x={group.x} y={group.y + 1.3 * scale} style={`font-size: ${4 * scale}px`}>
              {group.locations.length > 1 ? group.locations.length : '★'}
            </text>
          )}
        </g>
      );
    })}
  </svg>
  <div class="mission-map-footer">
    <span>★ Gold: critical coverage · numbers count locations</span>
    <strong>Explore the filtered map ↗</strong>
  </div>
</a>
