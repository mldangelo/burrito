---
import Base from '../layouts/Base.astro';
import SpinPick from '../components/SpinPick.astro';
import { path } from '../lib/catalog';
---

<Base title="This wrap got away" noindex>
  <div class="wrap">
    <header class="page-heading">
      <p class="eyebrow">404 / NO BURRITO HERE</p>
      <h1>
        This wrap
        <br />
        <em>got away.</em>
      </h1>
      <p class="dek">Plenty more where that came from. Spin the foil for a new one.</p>
      <div class="hero-actions">
        <a class="button primary" href={path('explore/')}>
          Back to the guide →
        </a>
        <SpinPick label="Spin for another →" />
      </div>
    </header>
  </div>
</Base>
