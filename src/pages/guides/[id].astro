---
import Base from '../../layouts/Base.astro';
import { guides } from '../../lib/guides';
import { places, path, absolute, shortName, primary, order, evidence } from '../../lib/catalog';
export function getStaticPaths() {
  return guides.map((guide) => ({ params: { id: guide.id }, props: { guide } }));
}
const { guide: g } = Astro.props;
const picks = g.ids.map((id) => places.find((p) => p.id === id)!);
const structured = [
  {
    '@context': 'https://schema.org',
    '@type': 'ItemList',
    name: g.label,
    description: g.description,
    itemListElement: picks.map((p, i) => ({
      '@type': 'ListItem',
      position: i + 1,
      name: p.name,
      url: absolute(`places/${p.id}/`),
    })),
  },
];
---

<Base title={g.label + ' in San Francisco'} description={g.description} structured={structured}>
  <div class="wrap">
    <header class="page-heading">
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href={path('guides/')}>Field notes</a>
        <span>/</span>
        <span>{g.label}</span>
      </nav>
      <p class="eyebrow">{g.eyebrow}</p>
      <h1>{g.title}</h1>
    </header>
    <div class="page-body">
      <p class="guide-intro">{g.intro}</p>
      <p class="small">
        A collection, not a ranking. Read each entry for its exact branch, evidence and current
        posted schedule.
      </p>
      {picks.map((p, i) => (
        <article class="guide-entry">
          <span class="number" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
          <div>
            <p class="eyebrow">
              {primary(p).neighborhood} · {evidence(p)}
            </p>
            <h2>
              <a href={path(`places/${p.id}/`)}>{shortName(p)} ↗</a>
            </h2>
            <p>
              <strong>{order(p)}</strong>
            </p>
            <p>{g.notes[p.id] ?? p.summary}</p>
            <p class="small">Main entry: {primary(p).address.street_address}</p>
            <a class="text-link" href={path(`places/${p.id}/`)}>
              Orders, hours & sources →
            </a>
          </div>
        </article>
      ))}
      <a class="button" href={path('explore/')}>
        Explore the whole guide ↗
      </a>
    </div>
  </div>
</Base>
