---
import Base from '../../layouts/Base.astro';
import { catalog, path, absolute, sourceMap } from '../../lib/catalog';
import { mapLocations, mapGroups } from '../../lib/map.mjs';
import { criticalReviews, mapStyles, reviewKinds } from '../../lib/map-filters.mjs';
import geocodes from '../../../data/geocodes.json';
import svg from '../../../public/maps/sf-burrito-map.svg?raw';
const inlineMap = svg
  .replace(/<\?xml[^>]*\?>\s*/, '')
  .replace('viewBox="0 0 1100 1090"', 'viewBox="30 195 1040 750"')
  .replace('width="1100" height="1090"', 'width="1040" height="750"')
  .replaceAll(absolute(), path());
const locations = mapLocations(catalog, geocodes);
const groups = mapGroups(locations);
const clientStops = locations.map((l) => {
  const place = catalog.places.find((p) => p.id === l.placeId)!;
  const branch = place.locations.find((b) => b.id === l.id)!;
  return {
    ...l,
    url: path(`places/${l.placeId}/#${l.id}`),
    order: place.standout_items.find((i) => i.location_ids.includes(l.id))?.name ?? null,
    directions: branch.maps_url,
    styles: place.styles,
    reviews: criticalReviews(place, l.id).map((review) => ({
      kind: review.evidence,
      label: reviewKinds[review.evidence],
      summary: review.summary,
      sources: review.source_ids.map((id) => {
        const source = sourceMap.get(id)!;
        return { title: source.title, url: source.url, publishedOn: source.published_on };
      }),
    })),
  };
});
const unmatched = catalog.places
  .filter((p) => p.status !== 'watchlist')
  .flatMap((p) =>
    p.locations
      .filter((l) => l.operating_status === 'listed' && !geocodes.locations[l.id])
      .map((l) => ({ place: p, location: l })),
  );
const structured = [
  {
    '@context': 'https://schema.org',
    '@type': 'Map',
    name: 'San Francisco burrito field map',
    url: absolute('map/'),
    image: absolute('maps/sf-burrito-map.svg'),
    description:
      'An interactive vector map of approximate burrito address locations, with restaurant name labels, style filters, critical-review highlights, search, branch details and source-linked neighborhood geography.',
  },
];
---

<Base
  title="The San Francisco burrito map"
  description={`An interactive SVG field map of San Francisco burrito stops. Search ${locations.length} approximate address locations, filter California- or Mission-style burritos, and highlight critic-reviewed branches.`}
  structured={structured}
>
  <div class="wrap">
    <header class="page-heading map-page-heading">
      <p class="eyebrow">THE CITY, BY THE BURRITO</p>
      <h1>
        A little geography.
        <br />
        <em>A lot of good lunches.</em>
      </h1>
      <p class="dek">
        Find a name. Follow a neighborhood. Drag, pinch or zoom to explore, then select a restaurant
        for its address, order and field notes.
      </p>
      <div class="map-actions">
        <a class="text-link" href={path('explore/?view=map')}>
          Open the street map ↗
        </a>
        <a class="text-link" href="#map-index">
          Jump to the stop index ↓
        </a>
      </div>
    </header>
    <div class="page-body">
      <figure class="field-map-figure">
        <div id="interactive-map-controls" hidden>
          <div class="interactive-map-controls">
            <form id="map-search-form" role="search">
              <label for="map-search">Find a restaurant, street or neighborhood</label>
              <div class="map-search-input">
                <input
                  id="map-search"
                  type="search"
                  placeholder="Try El Farolito or Mission"
                  autocomplete="off"
                />
                <button id="map-clear" class="quiet-button" type="button" hidden>
                  Clear
                </button>
              </div>
            </form>
            <div class="map-navigation" role="group" aria-label="Map navigation">
              <button id="map-zoom-out" type="button" aria-label="Zoom out">
                −
              </button>
              <button id="map-zoom-in" type="button" aria-label="Zoom in">
                +
              </button>
              <button id="map-fit" type="button">
                Fit city
              </button>
            </div>
          </div>
          <div class="map-filter-row">
            <fieldset class="map-style-filter" aria-describedby="map-style-hint">
              <legend>Burrito style</legend>
              <div class="map-style-options">
                {mapStyles.map((style) => (
                  <label>
                    <input
                      type="radio"
                      name="map-style"
                      value={style.id}
                      checked={style.id === 'all'}
                    />
                    <span>{style.label}</span>
                  </label>
                ))}
              </div>
              <p id="map-style-hint">Restaurant styles. Menus can vary by location.</p>
            </fieldset>
            <div class="map-review-filter">
              <label class="map-review-toggle">
                <input
                  id="map-highlight-reviews"
                  type="checkbox"
                  aria-describedby="map-review-hint"
                />
                <span aria-hidden="true">★</span> Highlight critically reviewed
              </label>
              <p id="map-review-hint">
                Gold marks burrito or restaurant coverage, including archive reviews. Select a stop
                for sources.
              </p>
            </div>
            <button id="map-neighborhood" class="chip selected" type="button" hidden></button>
            <button id="map-reset" class="quiet-button" type="button" hidden>
              Reset filters
            </button>
          </div>
        </div>
        <p id="map-status" class="map-live-status" role="status" aria-live="polite">
          {locations.length} mapped locations · select a name or marker
        </p>
        <div class="field-map-layout">
          <div
            class="field-map-scroll"
            id="map-drawing"
            role="region"
            aria-label="Burrito map. Drag to pan, pinch or use the zoom controls. Select a restaurant name or marker for details."
            tabindex="0"
            set:html={inlineMap}
          />
          <aside
            id="map-selection"
            class="map-selection"
            aria-labelledby="map-selection-title"
            hidden
          >
            <div class="map-selection-heading">
              <p class="eyebrow">YOUR NEXT STOP</p>
              <button id="close-selection" class="quiet-button" type="button" hidden>
                Clear selection
              </button>
            </div>
            <h2 id="map-selection-title" tabindex="-1">
              Find your next stop.
            </h2>
            <button id="zoom-selection" class="button" type="button" hidden>
              Zoom to these stops ↗
            </button>
            <div id="map-selection-body">
              <p>
                Select a restaurant name or a marker for its address, suggested order and field
                notes.
              </p>
            </div>
          </aside>
        </div>
        <figcaption>
          Names stay readable as you zoom. Crowded labels make room for one another; every marker
          still opens its full list. Nearby stops separate as you zoom in. All locations also appear
          in the index below. The{' '}
          <a href="https://data.sf.gov/d/gfpk-269f">DataSF neighborhood outlines</a> are general
          reference areas. Pins use approximate Census address matches; grouped pins sit at the
          average of their members.
        </figcaption>
      </figure>
      <section class="map-index" id="map-index">
        <div class="section-heading">
          <div>
            <p class="eyebrow">EVERY DOT HAS A DESTINATION</p>
            <h2>The stop index.</h2>
          </div>
          <span class="small">{locations.length} locations · north to south</span>
        </div>
        <div class="map-index-grid">
          {groups.map((g) => (
            <section class="map-stop-group" id={g.id}>
              <h3>
                {g.locations.length > 1
                  ? `${g.locations.length} nearby stops`
                  : g.locations[0].neighborhood}
              </h3>
              <ul>
                {g.locations.map((l) => (
                  <li>
                    <a href={path(`places/${l.placeId}/#${l.id}`)}>
                      {l.name}
                      <span>
                        {l.address} · {l.neighborhood}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
      <section class="map-unmatched">
        <h2>Off the map. Still in the guide.</h2>
        <p class="small">
          These {unmatched.length} listed locations have no accepted address coordinate. Their
          directions and field notes are still here.
        </p>
        <div class="branch-links">
          {unmatched.map(({ place, location: l }) => (
            <a href={path(`places/${place.id}/#${l.id}`)}>
              {place.name.split(' — ')[0]} · {l.address.street_address}
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
  <script
    id="field-map-data"
    type="application/json"
    set:html={JSON.stringify(clientStops).replace(/</g, '\\u003c')}
  />
  <script>
    import '../../scripts/field-map';
  </script>
</Base>
