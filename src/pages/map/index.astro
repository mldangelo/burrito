---
import Base from '../../layouts/Base.astro';
import { catalog, path, absolute } from '../../lib/catalog';
import { mapLocations, mapGroups } from '../../lib/map.mjs';
import geocodes from '../../../data/geocodes.json';
import svg from '../../../public/maps/sf-burrito-map.svg?raw';
const inlineMap = svg
  .replace(/<\?xml[^>]*\?>\s*/, '')
  .replace('viewBox="0 0 1100 1090"', 'viewBox="30 195 1040 750"')
  .replace('width="1100" height="1090"', 'width="1040" height="750"')
  .replaceAll(absolute(), path());
const locations = mapLocations(catalog, geocodes);
const groups = mapGroups(locations);
const unmatched = catalog.places
  .filter((p) => p.status !== 'watchlist')
  .flatMap((p) =>
    p.locations
      .filter((l) => l.operating_status === 'listed' && !geocodes.locations[l.id])
      .map((l) => ({ place: p, location: l })),
  );
const structured = [
  {
    '@context': 'https://schema.org',
    '@type': 'Map',
    name: 'San Francisco burrito field map',
    url: absolute('map/'),
    image: absolute('maps/sf-burrito-map.svg'),
    description:
      'An illustrated vector map of approximate burrito address locations, with source-linked neighborhood geography and grouped stop listings.',
  },
];
---

<Base
  title="The San Francisco burrito map"
  description="An illustrated SVG field map of San Francisco burrito stops. Explore neighborhoods and 73 approximate address locations, with clickable groups and a downloadable vector map."
  structured={structured}
>
  <div class="wrap">
    <header class="page-heading map-page-heading">
      <p class="eyebrow">THE CITY, BY THE BURRITO</p>
      <h1>
        A little geography.
        <br />
        <em>A lot of good lunches.</em>
      </h1>
      <p class="dek">
        Pick a dot. Follow a neighborhood. The numbered circles gather nearby locations; open one to
        see every stop inside.
      </p>
      <div class="map-actions">
        <a
          class="button primary"
          href={path('maps/sf-burrito-map.svg')}
          download="sf-burrito-map.svg"
        >
          Download the SVG ↓
        </a>
        <a class="text-link" href={path('explore/?view=map')}>
          Open the street map ↗
        </a>
        <a class="text-link" href="#map-index">
          Jump to the stop index ↓
        </a>
      </div>
    </header>
    <div class="page-body">
      <figure class="field-map-figure">
        <div class="map-toolbar">
          <p>
            <span class="map-legend-dot" aria-hidden="true"></span>
            {locations.length} locations · numbers group nearby stops
          </p>
          <div class="view-toggle map-scale" hidden aria-label="Map size">
            <button
              type="button"
              data-map-scale="fit"
              aria-controls="map-drawing"
              aria-pressed="true"
            >
              Fit city
            </button>
            <button
              type="button"
              data-map-scale="large"
              aria-controls="map-drawing"
              aria-pressed="false"
            >
              Enlarge
            </button>
          </div>
        </div>
        <div
          class="field-map-scroll"
          id="map-drawing"
          role="region"
          aria-label="Illustrated burrito map; enlarge for detail and scroll horizontally"
          tabindex="0"
          set:html={inlineMap}
        />
        <figcaption>
          Click or tab to a marker. Enlarge for labels and details, then scroll across the map.
          Every location also appears in the stop index below. The{' '}
          <a href="https://data.sf.gov/d/gfpk-269f">DataSF neighborhood outlines</a> are general
          reference areas. Pins use approximate Census address matches; grouped pins sit at the
          average of their members.
        </figcaption>
      </figure>
      <section class="map-index" id="map-index">
        <div class="section-heading">
          <div>
            <p class="eyebrow">EVERY DOT HAS A DESTINATION</p>
            <h2>The stop index.</h2>
          </div>
          <span class="small">{locations.length} locations · north to south</span>
        </div>
        <div class="map-index-grid">
          {groups.map((g) => (
            <section class="map-stop-group" id={g.id}>
              <h3>
                {g.locations.length > 1
                  ? `${g.locations.length} nearby stops`
                  : g.locations[0].neighborhood}
              </h3>
              <ul>
                {g.locations.map((l) => (
                  <li>
                    <a href={path(`places/${l.placeId}/#${l.id}`)}>
                      {l.name}
                      <span>
                        {l.address} · {l.neighborhood}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </section>
      <section class="map-unmatched">
        <h2>Off the map. Still in the guide.</h2>
        <p class="small">
          These {unmatched.length} listed locations have no accepted address coordinate. Their
          directions and field notes are still here.
        </p>
        <div class="branch-links">
          {unmatched.map(({ place, location: l }) => (
            <a href={path(`places/${place.id}/#${l.id}`)}>
              {place.name.split(' — ')[0]} · {l.address.street_address}
            </a>
          ))}
        </div>
      </section>
    </div>
  </div>
  <script>
    const map = document.querySelector<HTMLElement>('#map-drawing')!;
    const controls = [...document.querySelectorAll<HTMLButtonElement>('[data-map-scale]')];
    for (const button of controls)
      button.addEventListener('click', () => {
        const large = button.dataset.mapScale === 'large';
        map.classList.toggle('is-enlarged', large);
        for (const b of controls) b.setAttribute('aria-pressed', String(b === button));
        if (!large) map.scrollLeft = 0;
      });
    document.querySelector<HTMLElement>('.map-scale')!.hidden = false;
  </script>
</Base>
